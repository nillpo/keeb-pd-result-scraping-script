{
  "name": "keeb-pd-result-scraper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Userscript that scrapes KEEB_PD results from Twitter/X",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint",
    "fmt": "oxfmt src builder.ts",
    "fmt:check": "oxfmt --check src builder.ts",
    "build": "node builder.ts",
    "dev": "node --watch --watch-path=./src --watch-path=./builder.ts builder.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "rolldown": "1.3.2",
    "typescript": "7.0.2"
  }
}
